# Credentials and expected profile of a PESU Academy account, used only by the live tests
# (tests marked secret_required) and scripts/benchmark/benchmark_requests.py. The application
# itself never reads this file. Copy it to .env and never commit the copy.

# Sign-in details. The live tests log in with each of these, so all must belong to the same account,
# and none can be empty: without all of them the live tests are skipped.
TEST_EMAIL="john.doe@gmail.com"
# PRN: PES, campus digit, year of joining, 5-digit number
TEST_PRN="PESX20XX00XXX"
# SRN: PES, campus digit, program (UG, PG, ...), last two digits of the year of joining, branch, 3-digit
# number. For an account that joined before SRNs were introduced, this is the same as TEST_PRN.
TEST_SRN="PESXUGXXYYXXX"
# Also the mobile number the profile should return
TEST_PHONE="********"
TEST_PASSWORD="**********"

# The profile the API should return for that account, compared field by field. Every profile field
# has a variable here. Leave one empty if the account has no value for it: the API then returns null,
# which is what the live tests expect.
TEST_NAME="John Doe"
TEST_FIRST_NAME="John"
# Empty when the account has no middle name
TEST_MIDDLE_NAME=
TEST_LAST_NAME="Doe"
# As PESU writes it, such as B.Tech.
TEST_PROGRAM="B.Tech."
TEST_BRANCH="Computer Science and Engineering"
TEST_BRANCH_SHORT_CODE="CSE"
TEST_GENDER="Male"
# As YYYY-MM-DD
TEST_DATE_OF_BIRTH="2002-01-31"
# Leave TEST_SEMESTER and TEST_SECTION empty if the account has graduated.
TEST_SEMESTER="Sem-8"
TEST_SECTION="Section F"
# 1 and PES University (Ring Road), or 2 and PES University (Electronic City)
TEST_CAMPUS_CODE=2
TEST_CAMPUS="PES University (Electronic City)"
