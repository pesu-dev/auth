# Credentials and expected profile of a PESU Academy account, used only by the live tests
# (tests marked secret_required) and scripts/benchmark/benchmark_requests.py. The application
# itself never reads this file. Copy it to .env and never commit the copy.

# Sign-in details. The live tests log in with each of these, so all must belong to the same account.
TEST_EMAIL="john.doe@gmail.com"
TEST_PRN="PESX20XX00XXX"
TEST_SRN="PESXUGXXYYXXX"
TEST_PHONE="********"
TEST_PASSWORD="**********"

# The profile the API should return for that account, compared field by field.
TEST_NAME="John Doe"
TEST_PROGRAM="Bachelor of Technology"
TEST_BRANCH="Computer Science and Engineering"
# Set TEST_SEMESTER and TEST_SECTION to NA if the account is not in a class (for example, it has
# graduated): the API then returns those fields as null, which is what the live tests expect.
TEST_SEMESTER="Sem-8"
TEST_SECTION="Section F"
# 1 and RR for the Ring Road campus, 2 and EC for Electronic City
TEST_CAMPUS_CODE=2
TEST_CAMPUS="EC"
